<div class="ca-hud-root">
  {{#if hasAnyDirection}}
  <div class="ca-hud-destinations {{#if isOpen}}ca-hud-destinations--open{{/if}}">
    {{#each availableDestinations}}
    <button class="ca-hud-dest-btn" data-node-id="{{id}}" type="button">
      {{label}}
    </button>
    {{/each}}
  </div>
  {{/if}}

  <div class="ca-hud-orb" title="Click to navigate · Hold to drag">
    <div class="ca-hud-orb-inner"></div>
  </div>
</div>
