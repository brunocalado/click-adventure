<div class="ca-os-panel">

  {{#if isGM}}

  {{!-- Type --}}
  <div class="ca-os-section">
    <div class="ca-settings-section-title">Type</div>
    <div class="ca-os-type-row">
      {{#each typeOptions}}
      <button class="ca-os-type-btn {{#if (eq value ../orbType)}}ca-os-type-btn--active{{/if}}"
              data-type="{{value}}" type="button">{{label}}</button>
      {{/each}}
    </div>
  </div>

  {{!-- Size --}}
  <div class="ca-os-section">
    <div class="ca-settings-section-title">Size</div>
    <div class="ca-os-row">
      <label class="ca-settings-label">Scale</label>
      <input class="ca-os-size" type="range" min="0.75" max="2.5" step="0.25" value="{{orbSize}}">
      <span class="ca-os-size-label">{{orbSize}}×</span>
    </div>
  </div>

  {{!-- Color --}}
  <div class="ca-os-section">
    <div class="ca-settings-section-title">Color</div>
    <div class="ca-os-row">
      <label class="ca-settings-label">Base Color</label>
      <input class="ca-os-color" type="color" value="{{orbColor}}">
    </div>
    <p class="ca-settings-hint">Ignored when an image is set.</p>
  </div>

  {{!-- Image --}}
  <div class="ca-os-section">
    <div class="ca-settings-section-title">Image <span class="ca-os-optional">(optional)</span></div>
    <div class="ca-os-row">
      <span class="ca-os-image-path">{{#if orbImage}}{{orbImage}}{{else}}<em>None</em>{{/if}}</span>
      <button class="ca-os-image-browse" type="button">Browse…</button>
      {{#if orbImage}}<button class="ca-os-image-clear" type="button" title="Remove image">✕</button>{{/if}}
    </div>
    {{#if orbImage}}
    <div class="ca-os-image-thumb-wrap">
      <img class="ca-os-image-thumb {{#if (eq orbType 'square')}}ca-os-image-thumb--square{{/if}}" src="{{orbImage}}" alt="HUD button image preview" />
    </div>
    {{/if}}
  </div>

  {{else}}

  <div class="ca-os-section">
    <p class="ca-settings-hint">Only the GM can modify the HUD button style.</p>
  </div>

  {{/if}}

  {{!-- Preview --}}
  <div class="ca-os-section">
    <div class="ca-settings-section-title">Preview</div>
    <div class="ca-os-preview">
      {{#if orbImage}}
        <img class="ca-os-preview-img {{#if (eq orbType 'square')}}ca-os-preview-img--square{{/if}}"
             src="{{orbImage}}" alt="preview" />
      {{else}}
        <div class="ca-os-preview-shape {{#if (eq orbType 'square')}}ca-os-preview-shape--square{{/if}}"
             style="background: {{orbGradient}}; width: {{orbSizePx}}px; height: {{orbSizePx}}px;"></div>
      {{/if}}
    </div>
  </div>

</div>
