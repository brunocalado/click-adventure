<div class="ca-node-config">

  {{!-- Top field: always visible above tabs --}}
  <div class="ca-nc-field-group">
    <label class="ca-nc-label" for="ca-node-label-input">Default Scene Name</label>
    <div class="ca-nc-field-input-row">
      <input type="text" id="ca-node-label-input"
             class="ca-node-label-input"
             value="{{nodeLabel}}"
             maxlength="100"/>
      <span class="ca-nc-hint">max 100</span>
    </div>
  </div>

  {{!-- Tab bar --}}
  <div class="ca-nc-tabs" role="tablist">
    <button class="ca-nc-tab ca-nc-tab--active" data-tab="images"        role="tab">Images</button>
    <button class="ca-nc-tab"                   data-tab="linked-scenes" role="tab">Linked Scenes</button>
    <button class="ca-nc-tab"                   data-tab="settings"      role="tab">Settings</button>
  </div>

  {{!-- TAB: Images --}}
  <div class="ca-nc-panel" data-panel="images">
    <div class="ca-images-header">
      <button type="button" data-action="add-image">+ Add Image</button>
    </div>
    {{#if images.length}}
    <ul class="ca-images-list">
      {{#each images}}
      <li class="ca-image-item {{#if isActive}}ca-image-item--active{{/if}}">
        <div class="ca-image-left">
          <div class="ca-image-thumb"
               style="background-image: url('{{src}}');"
               data-src="{{src}}"
               data-index="{{index}}"
               role="button"
               aria-label="Preview or replace: {{label}}"
               title="Click to replace image"></div>
          <div class="ca-image-info">
            <span class="ca-image-nav-label">Navigation Name</span>
            <input type="text" class="ca-image-label-input" data-index="{{index}}"
                   value="{{label}}" maxlength="100"/>
            <div class="ca-image-actions">
              {{#unless isActive}}
              <button type="button" data-action="set-active" data-index="{{index}}"
                      title="Use this image as the default for this node">&#9733; Set Default</button>
              {{else}}
              <span class="ca-image-active-badge">&#9679; Default</span>
              {{/unless}}
              <button type="button" data-action="remove-image" data-index="{{index}}"
                      class="ca-btn-remove ca-btn-remove--labeled"
                      title="Remove this image from the node">Remove Entry</button>
            </div>
          </div>
        </div>
        {{!-- Macro column --}}
        <div class="ca-item-macro-col">
          {{#if hasMacro}}
            <div class="ca-item-macro-zone ca-item-macro-zone--filled">
              <span class="ca-item-macro-name" title="{{macroName}}">{{macroName}}</span>
              <div class="ca-item-macro-row">
                <button type="button" data-action="execute-image-macro" data-index="{{index}}"
                        title="Execute macro now">&#9654; Run</button>
                <button type="button" data-action="open-image-macro" data-index="{{index}}"
                        title="Open macro to edit">&#9741; Open</button>
                <button type="button" data-action="remove-image-macro" data-index="{{index}}"
                        class="ca-btn-remove ca-btn-remove--labeled"
                        title="Remove macro from this image">Remove Macro</button>
              </div>
              <select class="ca-image-macro-trigger" data-index="{{index}}">
                {{#each triggerOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          {{else}}
            <div class="ca-image-macro-dropzone ca-item-macro-zone" data-index="{{index}}">
              <span>Drop macro</span>
            </div>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="ca-images-empty">No images yet. Click "+ Add Image" to browse.</div>
    {{/if}}
  </div>

  {{!-- TAB: Linked Scenes --}}
  <div class="ca-nc-panel ca-nc-panel--hidden" data-panel="linked-scenes">
    <div class="ca-linked-scenes-dropzone" data-action="drop-scene">
      <span>Drag a scene here</span>
    </div>
    {{#if linkedScenes.length}}
    <ul class="ca-linked-scenes-list">
      {{#each linkedScenes}}
      <li class="ca-linked-scene-item">
        <div class="ca-linked-scene-left">
          <div class="ca-linked-scene-info">
            <input type="text" class="ca-linked-scene-label-input" data-index="{{index}}"
                   value="{{label}}" maxlength="100"/>
            <span class="ca-linked-scene-name">{{sceneName}}</span>
          </div>
          <div class="ca-linked-scene-actions">
            {{#unless isActive}}
            <button type="button" data-action="use-linked-scene" data-index="{{index}}"
                    title="Use this scene as the default for this node">&#9733; Set Default</button>
            {{else}}
            <span class="ca-image-active-badge">&#9679; Default</span>
            {{/unless}}
            <button type="button" data-action="remove-linked-scene" data-index="{{index}}"
                    class="ca-btn-remove ca-btn-remove--labeled"
                    title="Remove this linked scene">Remove Entry</button>
          </div>
        </div>
        {{!-- Macro column --}}
        <div class="ca-item-macro-col">
          {{#if hasMacro}}
            <div class="ca-item-macro-zone ca-item-macro-zone--filled">
              <span class="ca-item-macro-name" title="{{macroName}}">{{macroName}}</span>
              <div class="ca-item-macro-row">
                <button type="button" data-action="execute-linked-scene-macro" data-index="{{index}}"
                        title="Execute macro now">&#9654; Run</button>
                <button type="button" data-action="open-linked-scene-macro" data-index="{{index}}"
                        title="Open macro to edit">&#9741; Open</button>
                <button type="button" data-action="remove-linked-scene-macro" data-index="{{index}}"
                        class="ca-btn-remove ca-btn-remove--labeled"
                        title="Remove macro from this scene">Remove Macro</button>
              </div>
              <select class="ca-linked-scene-macro-trigger" data-index="{{index}}">
                {{#each triggerOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          {{else}}
            <div class="ca-linked-scene-macro-dropzone ca-item-macro-zone" data-index="{{index}}">
              <span>Drop macro</span>
            </div>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>

  {{!-- TAB: Settings --}}
  <div class="ca-nc-panel ca-nc-panel--hidden" data-panel="settings">
    <div class="ca-nc-settings-row">
      <div class="ca-nc-settings-item">
        <span class="ca-nc-settings-label">Start Node</span>
        <span class="ca-nc-settings-desc">Sets this node as the starting position for all players.</span>
      </div>
      <button type="button" data-action="toggle-start"
              class="ca-toggle-start {{#if isStartNode}}ca-toggle-start--active{{/if}}"
              title="{{#if isStartNode}}This is the start node{{else}}Set as start node for all players{{/if}}">
        {{#if isStartNode}}&#9733; Start Node{{else}}&#9734; Set as Start{{/if}}
      </button>
    </div>
  </div>

  {{!-- Footer actions: always visible --}}
  <div class="ca-node-config-actions">
    <button type="button" class="ca-btn-save"   data-action="save">Save</button>
    <button type="button" class="ca-btn-delete" data-action="delete-node">Delete Node</button>
  </div>

</div>
