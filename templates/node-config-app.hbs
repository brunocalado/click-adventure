<div class="ca-node-config">

  <div class="ca-node-preview">
    {{#if node.imageSrc}}
    <img src="{{node.imageSrc}}" alt="{{node.label}}" class="ca-node-preview-image"/>
    {{else}}
    <div class="ca-node-preview-empty">No image</div>
    {{/if}}
  </div>

  <div class="ca-node-config-row">
    <label>Label</label>
    <input type="text" class="ca-node-label-input" value="{{node.label}}"/>
  </div>

  <div class="ca-node-config-row">
    <label>Image</label>
    <button type="button" data-action="pick-image">Browse</button>
  </div>

  <div class="ca-node-config-actions">
    <button type="button" class="ca-btn-save" data-action="save">Save</button>
    <button type="button" class="ca-btn-delete" data-action="delete-node">Delete</button>
  </div>

</div>
