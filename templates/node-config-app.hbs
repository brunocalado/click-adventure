<div class="ca-node-config">

  <div class="ca-node-config-row">
    <label>Scene Name <span class="ca-char-limit">(max 100)</span></label>
    <input type="text" class="ca-node-label-input" value="{{nodeLabel}}" maxlength="100"/>
  </div>

  <div class="ca-images-section">
    <div class="ca-images-header">
      <span>Images</span>
      <button type="button" data-action="add-image" title="Add image">+ Add</button>
    </div>

    {{#if images.length}}
    <ul class="ca-images-list">
      {{#each images}}
      <li class="ca-image-item {{#if isActive}}ca-image-item--active{{/if}}">
        <div class="ca-image-thumb" style="background-image: url('{{src}}');"></div>
        <div class="ca-image-info">
          <span class="ca-image-nav-label">Navigation Name</span>
          <input type="text" class="ca-image-label-input" data-index="{{index}}" value="{{label}}"/>
          <div class="ca-image-actions">
            {{#unless isActive}}
            <button type="button" data-action="set-active" data-index="{{index}}" title="Set as active">&#9654; Use</button>
            {{else}}
            <span class="ca-image-active-badge">&#9679; Active</span>
            {{/unless}}
            <button type="button" data-action="remove-image" data-index="{{index}}" title="Remove image" class="ca-btn-remove">&#10005;</button>
          </div>
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="ca-images-empty">No images yet. Click "+ Add" to browse.</div>
    {{/if}}
  </div>

  <div class="ca-node-config-row ca-start-node-row">
    <span>Start Node</span>
    <button type="button" data-action="toggle-start"
            class="ca-toggle-start {{#if isStartNode}}ca-toggle-start--active{{/if}}"
            title="{{#if isStartNode}}This is the start node (set another node as start to change){{else}}Set this node as the start position for all players{{/if}}">
      {{#if isStartNode}}★ Start{{else}}☆ Set as Start{{/if}}
    </button>
  </div>

  <div class="ca-node-config-actions">
    <button type="button" class="ca-btn-save" data-action="save">Save</button>
    <button type="button" class="ca-btn-delete" data-action="delete-node">Delete Node</button>
  </div>

</div>
