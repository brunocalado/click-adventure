<div class="ca-node-config">

  <div class="ca-node-config-row">
    <label>Scene Name <span class="ca-char-limit">(max 100)</span></label>
    <input type="text" class="ca-node-label-input" value="{{nodeLabel}}" maxlength="100"/>
  </div>

  <div class="ca-images-section">
    <div class="ca-images-header">
      <span>Images</span>
      <button type="button" data-action="add-image" title="Add image">+ Add Image</button>
    </div>

    {{#if images.length}}
    <ul class="ca-images-list">
      {{#each images}}
      <li class="ca-image-item {{#if isActive}}ca-image-item--active{{/if}}">

        {{!-- Left: existing content --}}
        <div class="ca-image-left">
          <div class="ca-image-thumb" style="background-image: url('{{src}}');"></div>
          <div class="ca-image-info">
            <span class="ca-image-nav-label">Navigation Name</span>
            <input type="text" class="ca-image-label-input" data-index="{{index}}" value="{{label}}"/>
            <div class="ca-image-actions">
              {{#unless isActive}}
              <button type="button" data-action="set-active" data-index="{{index}}" title="Set as active">&#9654; Use</button>
              {{else}}
              <span class="ca-image-active-badge">&#9679; Active</span>
              {{/unless}}
              <button type="button" data-action="remove-image" data-index="{{index}}" title="Remove image" class="ca-btn-remove">&#10005;</button>
            </div>
          </div>
        </div>

        {{!-- Right: macro column --}}
        <div class="ca-item-macro-col">
          {{#if hasMacro}}
            <div class="ca-item-macro-row">
              <span class="ca-item-macro-name" title="{{macroName}}">{{macroName}}</span>
              <button type="button" data-action="execute-image-macro" data-index="{{index}}" title="Execute macro">&#9654;</button>
              <button type="button" data-action="remove-image-macro"  data-index="{{index}}" title="Remove macro" class="ca-btn-remove">&#10005;</button>
            </div>
            <select class="ca-image-macro-trigger" data-index="{{index}}">
              {{#each triggerOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          {{else}}
            <div class="ca-image-macro-dropzone" data-index="{{index}}">
              <span>Drop macro</span>
            </div>
          {{/if}}
        </div>

      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="ca-images-empty">No images yet. Click "+ Add Image" to browse.</div>
    {{/if}}
  </div>

  <div class="ca-linked-scenes-section">
    <div class="ca-images-header">
      <span>Linked Scenes</span>
    </div>

    <div class="ca-linked-scenes-dropzone" data-action="drop-scene">
      <span>Drag a scene here</span>
    </div>

    {{#if linkedScenes.length}}
    <ul class="ca-linked-scenes-list">
      {{#each linkedScenes}}
      <li class="ca-linked-scene-item">

        {{!-- Left: existing content --}}
        <div class="ca-linked-scene-left">
          <div class="ca-linked-scene-info">
            <input type="text" class="ca-linked-scene-label-input" data-index="{{index}}" value="{{label}}"/>
            <span class="ca-linked-scene-name">{{sceneName}}</span>
          </div>
          <div class="ca-linked-scene-actions">
            {{#unless isActive}}
            <button type="button" data-action="use-linked-scene" data-index="{{index}}" title="Activate this scene">&#9654; Use</button>
            {{else}}
            <span class="ca-image-active-badge">&#9679; Active</span>
            {{/unless}}
            <button type="button" data-action="remove-linked-scene" data-index="{{index}}" title="Remove" class="ca-btn-remove">&#10005;</button>
          </div>
        </div>

        {{!-- Right: macro column --}}
        <div class="ca-item-macro-col">
          {{#if hasMacro}}
            <div class="ca-item-macro-row">
              <span class="ca-item-macro-name" title="{{macroName}}">{{macroName}}</span>
              <button type="button" data-action="execute-linked-scene-macro" data-index="{{index}}" title="Execute macro">&#9654;</button>
              <button type="button" data-action="remove-linked-scene-macro"  data-index="{{index}}" title="Remove macro" class="ca-btn-remove">&#10005;</button>
            </div>
            <select class="ca-linked-scene-macro-trigger" data-index="{{index}}">
              {{#each triggerOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          {{else}}
            <div class="ca-linked-scene-macro-dropzone" data-index="{{index}}">
              <span>Drop macro</span>
            </div>
          {{/if}}
        </div>

      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>

  <div class="ca-node-config-row ca-start-node-row">
    <span>Start Node</span>
    <button type="button" data-action="toggle-start"
            class="ca-toggle-start {{#if isStartNode}}ca-toggle-start--active{{/if}}"
            title="{{#if isStartNode}}This is the start node (set another node as start to change){{else}}Set this node as the start position for all players{{/if}}">
      {{#if isStartNode}}★ Start{{else}}☆ Set as Start{{/if}}
    </button>
  </div>

  <div class="ca-node-config-actions">
    <button type="button" class="ca-btn-save" data-action="save">Save</button>
    <button type="button" class="ca-btn-delete" data-action="delete-node">Delete Node</button>
  </div>

</div>
