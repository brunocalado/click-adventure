<div class="ca-settings-panel">

  <div class="ca-tabs-header">
    <nav class="ca-tabs-nav ca-settings-tabs" role="tablist">
    <button type="button" class="ca-tab ca-settings-tab ca-tab--active" data-tab="scenes" role="tab">Scenes</button>
    <button type="button" class="ca-tab ca-settings-tab" data-tab="hud"    role="tab">HUD</button>
    <button type="button" class="ca-tab ca-settings-tab" data-tab="tokens" role="tab">Tokens</button>
    <button type="button" class="ca-tab ca-settings-tab" data-tab="danger" role="tab">Danger</button>
    </nav>
  </div>

  {{!-- ── Scenes ─────────────────────────────────────────────────────── --}}
  <div class="ca-settings-panel-tab" data-panel="scenes">
    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label" for="ca-transition-type">Transition Type</label>
        <select class="ca-input ca-settings-transition" id="ca-transition-type">
          {{#each transitionOptions}}
          <option value="{{value}}" {{#if (eq value ../transitionType)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="ca-hint ca-setting-card-desc">Applied to all scenes on Create / Update Scenes. Hops that fly over an overview map skip it.</p>
    </div>

    <div class="ca-card ca-setting-card ca-flight-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Flight over Map</label>
        <button type="button" role="switch" aria-checked="{{#if flight.enabled}}true{{else}}false{{/if}}"
                class="ca-switch ca-flight-enabled {{#if flight.enabled}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">This group only. In Guide mode, double-click a room on the
        overview map to take the party there, and use Map in the HUD to bring them back out.</p>
      {{#if flight.enabled}}
        {{#if flight.overviewName}}
        <div class="ca-flight-row">
          <span class="ca-flight-text">Overview: <strong>{{flight.overviewName}}</strong></span>
          <button class="ca-btn ca-btn--quiet ca-flight-open" type="button"><i class="fa-solid fa-eye"></i> Open</button>
          <button class="ca-btn ca-btn--quiet ca-flight-change-map" type="button"><i class="fa-solid fa-image"></i> Change map…</button>
        </div>
        <div class="ca-flight-row">
          <span class="ca-flight-text">Pace</span>
          <div class="ca-btn-group ca-flight-pace">
            {{#each flight.paces}}
            <button type="button" class="ca-btn-group-btn {{#if active}}ca-btn-group-btn--active{{/if}}" data-value="{{value}}">{{label}}</button>
            {{/each}}
          </div>
        </div>
        <div class="ca-flight-row">
          <span class="ca-flight-text">Room name</span>
          <div class="ca-btn-group ca-flight-name">
            <button type="button" class="ca-btn-group-btn {{#if flight.caption}}ca-btn-group-btn--active{{/if}}" data-value="on">Shown</button>
            <button type="button" class="ca-btn-group-btn {{#unless flight.caption}}ca-btn-group-btn--active{{/unless}}" data-value="off">Hidden</button>
          </div>
        </div>
        <div class="ca-flight-row">
          <span class="ca-flight-text">Travel sound: <strong>{{#if flight.sound}}{{flight.sound.name}}{{else}}None{{/if}}</strong></span>
          <button class="ca-btn ca-btn--quiet ca-flight-sound-choose" type="button"><i class="fa-solid fa-music"></i> Choose…</button>
          {{#if flight.sound}}
          <button class="ca-btn ca-btn--quiet ca-flight-sound-clear" type="button"><i class="fa-solid fa-xmark"></i> Clear</button>
          <input class="ca-flight-sound-volume" type="range" min="0" max="1" step="0.05" value="{{flight.sound.volume}}" aria-label="Travel sound volume">
          {{/if}}
        </div>
        <p class="ca-flight-text ca-flight-status">{{flight.linkedCount}} of {{flight.nodeCount}} nodes linked to a room</p>
        {{#if flight.unlinked.length}}
        <ul class="ca-flight-unlinked">
          {{#each flight.unlinked}}
          <li class="ca-flight-row">
            <span class="ca-flight-text">{{label}}</span>
            <select class="ca-input ca-flight-region-select" data-node-id="{{id}}">
              <option value="">— none —</option>
              {{#each ../flight.regionOptions}}
              <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </li>
          {{/each}}
        </ul>
        {{/if}}
        {{#each flight.ambiguous}}
        <p class="ca-hint ca-flight-warning">{{label}}: several rooms match ({{regions}})</p>
        {{/each}}
        <div class="ca-flight-row">
          <button class="ca-btn ca-btn--quiet ca-flight-preview" type="button"><i class="fa-solid fa-plane"></i> Preview</button>
          <button class="ca-btn ca-btn--quiet ca-flight-import" type="button"><i class="fa-solid fa-file-import"></i> Import room data…</button>
          <input type="file" accept=".json" hidden class="ca-flight-file-input">
        </div>
        {{else}}
        <button class="ca-btn ca-btn--blue ca-flight-choose-map" type="button"><i class="fa-solid fa-map"></i> Choose map image…</button>
        {{/if}}
      {{/if}}
    </div>
  </div>

  {{!-- ── HUD ────────────────────────────────────────────────────────── --}}
  <div class="ca-settings-panel-tab ca-settings-panel-tab--hidden" data-panel="hud">
    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Visible to</label>
        <div class="ca-btn-group" data-setting="hudVisibility">
          <button class="ca-btn-group-btn {{#if (eq hudVisibility 'all')}}ca-btn-group-btn--active{{/if}}"
                  type="button" data-value="all">All players</button>
          <button class="ca-btn-group-btn {{#if (eq hudVisibility 'gm-only')}}ca-btn-group-btn--active{{/if}}"
                  type="button" data-value="gm-only">GM only</button>
        </div>
      </div>
      <p class="ca-hint ca-setting-card-desc">Controls which users see the navigation HUD. The GM always sees it regardless of this setting.</p>
    </div>

    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Show Player Locations</label>
        <button type="button" role="switch" data-setting="showPlayerWhisper"
                aria-checked="{{#if showPlayerWhisper}}true{{else}}false{{/if}}"
                class="ca-switch {{#if showPlayerWhisper}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">When enabled, players see other connected players in their HUD and can preview the node image of where each player is.</p>
    </div>

    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Player Destination Preview</label>
        <button type="button" role="switch" data-setting="playerDestinationPreview"
                aria-checked="{{#if playerDestinationPreview}}true{{else}}false{{/if}}"
                class="ca-switch {{#if playerDestinationPreview}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">When enabled, players can hover the eye icon on a destination to preview its room image before entering. The GM always sees previews.</p>
    </div>

    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Journal Auto-Open</label>
        <button type="button" role="switch" data-setting="journalAutoOpen"
                aria-checked="{{#if journalAutoOpen}}true{{else}}false{{/if}}"
                class="ca-switch {{#if journalAutoOpen}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">When enabled, a node's journal page opens automatically once its trigger condition is met. Turn it off during setup and testing, or when the pop-ups are just in the way — each node keeps its own trigger either way.</p>
    </div>
  </div>

  {{!-- ── Tokens ─────────────────────────────────────────────────────── --}}
  <div class="ca-settings-panel-tab ca-settings-panel-tab--hidden" data-panel="tokens">
    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Guide Mode</label>
        <div class="ca-btn-group" data-setting="guideModeAction">
          <button class="ca-btn-group-btn {{#if (eq guideModeAction 'view')}}ca-btn-group-btn--active{{/if}}"
                  type="button" data-value="view">View (per-player)</button>
          <button class="ca-btn-group-btn {{#if (eq guideModeAction 'activate')}}ca-btn-group-btn--active{{/if}}"
                  type="button" data-value="activate">Activate (global)</button>
        </div>
      </div>
      <p class="ca-hint ca-setting-card-desc">
        <strong>View:</strong> sends each player to the scene individually via socket.<br>
        <strong>Activate:</strong> activates the scene globally — Foundry pulls all connected users in automatically. Simpler, but affects everyone on the server.
      </p>
    </div>

    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Load Player Tokens</label>
        <button type="button" role="switch"
                aria-checked="{{#if loadPlayerTokens}}true{{else}}false{{/if}}"
                class="ca-switch ca-load-player-tokens {{#if loadPlayerTokens}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">
        <strong>Enabled:</strong> a player's linked-actor token is automatically created/moved into a node's scene as they navigate.<br>
        <strong>Disabled:</strong> no tokens are placed — navigation only changes the view. Applies to the current group only; tokens already in a scene are left in place.
      </p>
    </div>

    <div class="ca-card ca-setting-card">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Saved Positions</label>
        <button type="button" role="switch" data-setting="useDefaultTokenPositions"
                aria-checked="{{#if useDefaultTokenPositions}}true{{else}}false{{/if}}"
                class="ca-switch {{#if useDefaultTokenPositions}}ca-switch--on{{/if}}">
          <span class="ca-switch-track"><span class="ca-switch-knob"></span></span>
        </button>
      </div>
      <button class="ca-btn ca-btn--quiet ca-capture-token-pos" type="button">
        <i class="fa-solid fa-crosshairs"></i> Capture Positions
      </button>
      <p class="ca-hint ca-setting-card-desc">
        <strong>Enabled:</strong> teleported tokens spawn at the last captured positions.<br>
        <strong>Disabled:</strong> tokens appear at the same position they had in the previous scene. Falls back to scene center if no previous position exists.
      </p>
    </div>
  </div>

  {{!-- ── Danger ─────────────────────────────────────────────────────── --}}
  <div class="ca-settings-panel-tab ca-settings-panel-tab--hidden" data-panel="danger">
    <div class="ca-card ca-setting-card ca-card--danger">
      <div class="ca-setting-card-main">
        <label class="ca-label ca-settings-label">Reset Group</label>
        <button class="ca-btn ca-btn--danger ca-reset-graph" type="button">
          <i class="fa-solid fa-trash"></i> Reset Group
        </button>
      </div>
      <p class="ca-hint ca-setting-card-desc">Deletes <strong>all nodes, links and Foundry Scenes</strong> in the <strong>current group</strong>. Other groups are untouched. This cannot be undone.</p>
    </div>
  </div>

</div>
