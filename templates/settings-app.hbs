<div class="ca-settings-panel">

  <div class="ca-settings-section">
    <div class="ca-settings-section-title">Scene Transition</div>
    <div class="ca-settings-row">
      <label class="ca-settings-label" for="ca-transition-type">Transition Type</label>
      <select class="ca-settings-transition" id="ca-transition-type">
        {{#each transitionOptions}}
        <option value="{{value}}" {{#if (eq value ../transitionType)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="ca-settings-hint">Applied to all scenes on Create / Update Scenes.</p>
  </div>

  <div class="ca-settings-section">
    <div class="ca-settings-section-title">HUD Visibility</div>
    <div class="ca-settings-row">
      <label class="ca-settings-label">Visible to</label>
      <div class="ca-btn-group" data-setting="hudVisibility">
        <button class="ca-btn-group-btn {{#if (eq hudVisibility 'all')}}ca-btn-group-btn--active{{/if}}"
                type="button" data-value="all">All players</button>
        <button class="ca-btn-group-btn {{#if (eq hudVisibility 'gm-only')}}ca-btn-group-btn--active{{/if}}"
                type="button" data-value="gm-only">GM only</button>
      </div>
    </div>
    <p class="ca-settings-hint">Controls which users see the navigation HUD. The GM always sees it regardless of this setting.</p>
  </div>

  <div class="ca-settings-section">
    <div class="ca-settings-section-title">Guide Mode</div>
    <div class="ca-settings-row">
      <label class="ca-settings-label">Action</label>
      <div class="ca-btn-group" data-setting="guideModeAction">
        <button class="ca-btn-group-btn {{#if (eq guideModeAction 'view')}}ca-btn-group-btn--active{{/if}}"
                type="button" data-value="view">View (per-player)</button>
        <button class="ca-btn-group-btn {{#if (eq guideModeAction 'activate')}}ca-btn-group-btn--active{{/if}}"
                type="button" data-value="activate">Activate (global)</button>
      </div>
    </div>
    <p class="ca-settings-hint">
      <strong>View:</strong> sends each player to the scene individually via socket.<br>
      <strong>Activate:</strong> activates the scene globally — Foundry pulls all connected users in automatically. Simpler, but affects everyone on the server.
    </p>
  </div>

  <div class="ca-settings-section">
    <div class="ca-settings-section-title">Token Placement</div>
    <div class="ca-settings-row">
      <label class="ca-settings-label">Use saved positions</label>
      <button class="ca-toggle-btn {{#if useDefaultTokenPositions}}ca-toggle-btn--active{{/if}}"
              type="button" data-setting="useDefaultTokenPositions"
              data-value-on="true" data-value-off="false">
        {{#if useDefaultTokenPositions}}Enabled{{else}}Disabled{{/if}}
      </button>
    </div>
    <div class="ca-settings-row">
      <button class="ca-capture-token-pos" type="button">Capture Token Positions</button>
    </div>
    <p class="ca-settings-hint">
      When enabled, teleported tokens spawn at the captured positions instead of scene center.
      Capturing positions automatically enables this setting.
    </p>
  </div>

</div>
