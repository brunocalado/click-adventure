{{!-- Click Adventure tab rendered inside the Tile sheet via AppV2 PARTS --}}
<div class="tab" data-group="sheet" data-tab="adventure">
  <div class="form-group">
    <label>Navigate to Scene</label>
    <div class="form-fields">
      <select name="click-adventure.targetSceneId">
        <option value="">— No navigation —</option>
        {{#each scenes}}
          <option value="{{this.id}}" {{selected this.id ../targetSceneId}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">When a player clicks this tile, they will be taken to the selected scene. Leave empty to disable navigation.</p>
  </div>
</div>
