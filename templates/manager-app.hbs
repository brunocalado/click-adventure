<div class="ca-manager">
  <div class="ca-toolbar">
    <button class="ca-add-node" type="button" title="Add Scene Node">+</button>
    <button class="ca-auto-arrange" type="button" title="Auto Arrange">Auto Arrange</button>
    {{#if graphSceneId}}
    <button class="ca-view-scene" type="button" title="View linked Foundry Scene">View Scene</button>
    {{else}}
    <button class="ca-new-scene" type="button" title="Create New Foundry Scene">New Scene</button>
    {{/if}}
    <button class="ca-reset-graph" type="button" title="Delete all nodes, links and scene binding">Reset</button>
  </div>
  <div class="ca-workspace">
    <svg class="ca-links-layer" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"></svg>
    {{#each nodes}}
    <div class="ca-node" data-node-id="{{id}}" style="left: {{x}}px; top: {{y}}px;"
         {{#if (eq id ../currentNodeId)}}data-current="true"{{/if}}>
      <div class="ca-node-body">
        {{#if imageSrc}}
        <div class="ca-node-image" style="background-image: url('{{imageSrc}}');"></div>
        {{else}}
        <div class="ca-node-image ca-node-image--empty"></div>
        {{/if}}
        <span class="ca-node-label">{{label}}</span>
      </div>
      <button class="ca-set-current-btn" data-node-id="{{id}}" type="button"
              title="Set as current location">
        <span class="ca-scb-ring"></span>
        <span class="ca-scb-dot"></span>
      </button>
      <div class="ca-anchor ca-anchor-top"    data-anchor="top"></div>
      <div class="ca-anchor ca-anchor-right"  data-anchor="right"></div>
      <div class="ca-anchor ca-anchor-bottom" data-anchor="bottom"></div>
      <div class="ca-anchor ca-anchor-left"   data-anchor="left"></div>
    </div>
    {{/each}}
  </div>
</div>
