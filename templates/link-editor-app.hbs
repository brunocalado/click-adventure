<div class="ca-link-editor">
  <div class="ca-link-editor-header">
    <div class="ca-link-nodes-display">
      <span class="ca-node-badge ca-node-badge--source" title="{{fromLabel}}">{{fromLabel}}</span>
      <span class="ca-node-arrow">↔</span>
      <span class="ca-node-badge ca-node-badge--target" title="{{toLabel}}">{{toLabel}}</span>
    </div>
  </div>
  <ul class="ca-passages-list">
    {{#each passages}}
    <li class="ca-passage-row" data-index="{{index}}">
      <input class="ca-passage-label" type="text" value="{{label}}" placeholder="Passage name (optional)" maxlength="100" />
      <button class="ca-display-mode-toggle" type="button"
              title="{{#if displayModeIsPathOnly}}Players see: Path Name only{{else}}Players see: Full Name (Path Name){{/if}}">
        {{#if displayModeIsPathOnly}}P{{else}}F{{/if}}
      </button>
      <button class="ca-passage-direction" type="button" title="Click to cycle direction"
              data-direction="{{direction}}">{{caDirectionIcon direction}}</button>
      <button class="ca-passage-remove" type="button" title="Remove passage">✕</button>
    </li>
    {{/each}}
  </ul>
  <div class="ca-link-editor-footer">
    <button class="ca-passage-add" type="button">+ Add passage</button>
    {{#if isMulti}}
    <button class="ca-convert-to-single" type="button" title="Remove all passages except the first and revert to single-passage mode">Convert to single</button>
    {{/if}}
    <button class="ca-link-editor-save" type="button">Save</button>
  </div>
</div>
